# ==============================================================================
# Story Arc Backend - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure the values according to your environment.
# cp .env.example .env

# Server Environment & Port
NODE_ENV=development
PORT=8000

# Database Configuration (Required)
# Example Local: mongodb://localhost:27017/story_arc_dev
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/story_arc_prod?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/story_arc_dev

# Allowed Client Origins for CORS and CSRF Protection (Comma-separated)
CLIENT_URLS=http://localhost:3000,http://localhost:5173
CLIENT_URL=http://localhost:3000

# Rate Limiting Configuration (Optional, defaults shown)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=10
REFRESH_RATE_LIMIT_WINDOW_MINUTES=15
REFRESH_RATE_LIMIT_MAX=20

# JWT Secrets & Expiration (Required - Minimum 32 characters)
# Generate via: openssl rand -base64 32
JWT_ACCESS_SECRET=your_super_secret_access_token_key_min_32_characters_here
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_min_32_characters_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email Delivery Configuration
# In development (NODE_ENV=development), Nodemailer automatically uses Ethereal test accounts.
# In production (NODE_ENV=production), Brevo API is used and requires BREVO_API_KEY.
BREVO_API_KEY=
EMAIL_FROM_NAME="Story Arc"
EMAIL_FROM_ADDRESS=noreply@storyarc.com

# Password Reset & Email Rate Limiting
PASSWORD_RESET_EXPIRES_MINUTES=15
PASSWORD_RESET_EMAIL_RATE_LIMIT_WINDOW_MINUTES=60
PASSWORD_RESET_EMAIL_RATE_LIMIT_MAX=3
EMAIL_VERIFICATION_EXPIRES_HOURS=24
RESEND_VERIFICATION_EMAIL_RATE_LIMIT_WINDOW_MINUTES=60
RESEND_VERIFICATION_EMAIL_RATE_LIMIT_MAX=3

# Google OAuth2 SSO (Optional, required for Google Login)
GOOGLE_CLIENT_ID=

# Initial Super Admin Account Seeding (Used by `pnpm seed:admin`)
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=admin@storyarc.com
SUPER_ADMIN_PASSWORD=your_secure_admin_password_here


